{
  "name": "conductor/mysql-database-support",
  "version": "7.1.0",
  "description": "Conductor MySQL Database Support",
  "type": "library",
  "homepage": "https://github.com/conductorphp/mysql-database-support",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Kirk Madera",
      "email": "kirk.madera@rmgmedia.com",
      "role": "Architect"
    }
  ],
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "~8.4.1|~8.5.0",
    "conductor/core": "^7.0"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^2.5.0",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "ConductorMySqlSupport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ConductorMySqlSupportTest\\": "test/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "ConductorMySqlSupport\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test": "phpunit --colors=always",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
  },
  "suggest": {
    "ext-openssl": "Needed when TLS verifies against the system CA bundle (\"tls_ca\" empty); checked at first use.",
    "ext-pdo_mysql": "Required by the DatabaseAdapter (checked when the adapter is selected).",
    "mydumper": "mydumper/myloader 1.0.5+ on PATH for the Mydumper import/export adapter.",
    "mariadb-client": "mysql/mysqldump/mysqlimport on PATH for the Mysqldump and TabDelimited adapters."
  }
}